{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skill-concerns/contracts/code-map.schema.json",
  "title": "Code Map",
  "type": "object",
  "required": ["schema_version", "subject", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "subject": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "symbol"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["entrypoint", "module", "function", "state-store", "provider-boundary", "control-boundary"]},
          "path": {"type": "string"},
          "symbol": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "relation"],
        "properties": {
          "id": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "relation": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
