{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skill-concerns/contracts/feature-code-map.schema.json",
  "title": "Feature-to-Code Map",
  "type": "object",
  "required": ["schema_version", "source_commit", "feature", "feature_edges"],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "feature": {"type": "string"},
    "feature_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transition_id", "code_nodes", "required_journeys"],
        "properties": {
          "transition_id": {"type": "string"},
          "code_nodes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "required_journeys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
