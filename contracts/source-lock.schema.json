{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skill-concerns/contracts/source-lock.schema.json",
  "title": "Frozen Skill source",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "source_kind",
    "locked_files",
    "method_references"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill": {
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "git",
        "owner-design-brief"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "locked_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "method_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "commit",
          "path",
          "blob_sha"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string"
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
