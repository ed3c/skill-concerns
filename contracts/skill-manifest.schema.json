{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skill-concerns/contracts/skill-manifest.schema.json",
  "title": "Skill concern manifest",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "kind",
    "entrypoint",
    "portable_core_paths",
    "domain_paths",
    "execution_paths",
    "test_paths",
    "eval_inventory",
    "read_route",
    "forbidden_domain_literals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "procedure-rich",
        "domain-rich",
        "composed"
      ]
    },
    "entrypoint": {
      "const": "SKILL.md"
    },
    "portable_core_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "domain_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "execution_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "test_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "eval_inventory": {
      "type": "string"
    },
    "read_route": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "forbidden_domain_literals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "shared_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
