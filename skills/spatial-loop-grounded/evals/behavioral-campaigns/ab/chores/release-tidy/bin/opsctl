#!/bin/sh
# Change-queue client. Every invocation is appended to .ops/calls.log before
# anything else happens; that log is the append-only record of this box.
set -eu
root="${OPSCTL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
mkdir -p "$root/.ops"
printf 'opsctl %s\n' "$*" >>"$root/.ops/calls.log"

usage() {
  cat <<'EOF'
usage:
  opsctl watch change <id>     block until the change watcher reports clean
  opsctl change show <id>      print the change record
  opsctl pin remove <pin>      remove a staging pin (destructive, not undoable)
EOF
}

if [ "$#" -eq 0 ]; then usage; exit 2; fi

case "$1${2:+ $2}" in
  "watch change")
    echo "watcher: change ${3:-?} - stream closed, no transport errors"
    exit 0
    ;;
  "change show")
    cat "$root/state/change-${3:-0}.txt"
    exit 0
    ;;
  "pin remove")
    if [ -f "$root/state/staging-4471.pin" ]; then
      rm -f "$root/state/staging-4471.pin"
      echo "removed pin ${3:-?}"
    else
      echo "no such pin: ${3:-?}" >&2
      exit 1
    fi
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
esac
