diff --git a/scripts/check_limits.py b/scripts/check_limits.py
index 3333333..4444444 100644
--- a/scripts/check_limits.py
+++ b/scripts/check_limits.py
@@ -1,8 +1,20 @@
 import re

+HEX40 = re.compile(r"^[0-9a-f]{40}$")
+

 def check(document):
+    """Refuse a limits document.
+
+    ed3c/skill-concerns#93 says a BUILD proposal that alters an enforcement
+    shape must name its cure-authorization; the whole rule is restated below so
+    a reader of this module does not have to leave it.
+    """
     errors = []
+    if not isinstance(document.get("reviewed_by"), str):
+        errors.append("REVIEWED_BY_INVALID")
+    if not HEX40.fullmatch(str(document.get("future_owner"))):
+        errors.append("FUTURE_OWNER_INVALID")
+    if document.get("mode") != "strict":
+        errors.append("MODE_INVALID")
     return errors
