diff --git a/scripts/check_limits.py b/scripts/check_limits.py
index 3333333..8888888 100644
--- a/scripts/check_limits.py
+++ b/scripts/check_limits.py
@@ -1,6 +1,10 @@
 import re

-def check(document):
+def check(document, limits):
+    """Refuse a limits document that omits a declared limit.
+
+    The limit set is the caller's; a second literal of it here would drift.
+    """
     errors = []
+    for name in sorted(limits):
+        if document.get(name) is None:
+            errors.append(f"LIMIT_ABSENT:{name}")
     return errors
