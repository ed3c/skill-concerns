{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/architecture-context-pack.schema.json",
  "title": "Architecture Context Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "subject", "contributor_context", "design_objective", "invariants", "carriers", "claims", "divergences", "negative_claims", "best_path", "evidence_manifest"],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "contributor_context": {"type": "string", "minLength": 1},
    "design_objective": {"type": "string", "minLength": 1},
    "invariants": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/invariant"}
    },
    "carriers": {
      "type": "array",
      "items": {"$ref": "#/$defs/carrier"}
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "divergences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "negative_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "best_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_manifest": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "authority": {"enum": ["SOURCE", "N", "P", "L", "R", "MIXED", "UNKNOWN"]},
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "statement", "claim_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "carrier": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "responsibility", "invariant_refs", "claim_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "invariant_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "semantic_kernel", "domain_realization", "authority_ceiling", "evidence_ids", "negative_claims", "best_path_consequence"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^[A-Z0-9_.-]+$"},
        "semantic_kernel": {"type": "string", "minLength": 1},
        "domain_realization": {"type": "string", "minLength": 1},
        "authority_ceiling": {"$ref": "#/$defs/authority"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "negative_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "best_path_consequence": {"type": "string", "minLength": 1}
      }
    }
  }
}
